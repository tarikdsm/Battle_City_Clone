{
  "name": "battle-city",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Battle City remake — Vite + TypeScript + Three.js web game.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "levels:preview": "tsx scripts/level-preview.ts",
    "levels:transcribe": "tsx scripts/transcribe-original-stages.ts",
    "levels:author": "tsx scripts/author-neo-stages.ts",
    "replays:record": "tsx scripts/record-replay.ts",
    "calibrate:lighting": "tsx scripts/calibrate-lighting.ts",
    "capture:entities": "tsx scripts/capture-entities.ts",
    "capture:post": "tsx scripts/capture-post.ts",
    "capture:play": "tsx scripts/capture-play.ts",
    "capture:fx": "tsx scripts/capture-fx.ts",
    "capture:audio": "tsx scripts/capture-audio.ts",
    "capture:ui": "tsx scripts/capture-ui.ts",
    "capture:campaign": "tsx scripts/capture-campaign.ts",
    "capture:editor": "tsx scripts/capture-editor.ts",
    "capture:neo": "tsx scripts/capture-neo.ts",
    "capture:platform": "tsx scripts/capture-platform.ts",
    "icons": "tsx scripts/gen-icons.ts"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.2",
    "@types/three": "0.185.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
